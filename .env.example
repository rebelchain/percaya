# Data mode: "demo" (deterministic fixtures, no RPC needed) or "chain" (Solana Devnet + Indexer)
DATA=demo
CLUSTER=devnet

# Solana RPC endpoints (use dedicated Helius/Triton Devnet key for live demo)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Deployed Anchor Program IDs
PERCAYA_PROGRAM_ID=8ZMPKC79FfVvKsQXudDUJfGmmSMRd1HkY2QU7anrCcf6
PERCAYA_AMM_PROGRAM_ID=AzU89s97v6XKT8oKkyV82p2k17z1eK2aFhGwrXTpquxz

# API Server
PORT=8787
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
SIWS_SECRET=dev-only-replace-in-production-32bytes

# Database (leave empty in chain/dev mode to use embedded PGlite)
DATABASE_URL=

# Automated Keeper (Base58 or JSON array of 64-byte Solana secret key)
KEEPER_SECRET_KEY=

# Optional Telegram Live Call Channel Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
