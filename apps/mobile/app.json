{
  "expo": {
    "name": "percaya",
    "slug": "percaya",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "percaya",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2F5F7",
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "percaya uses the camera only to scan Call QR codes. Nothing is recorded or uploaded.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.percaya.seeker",
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#1F6E9C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "percaya.duckdns.org",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "percaya.app",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "percaya"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}
