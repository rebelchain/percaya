{
  "name": "@percaya/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild:android": "expo prebuild --platform android",
    "android": "expo run:android",
    "build:apk": "cd android && ./gradlew assembleRelease",
    "setup:signing": "node scripts/setup-release-signing.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/call-links.test.ts src/call-diff.test.ts src/onboarding.test.ts src/theme/format.test.ts scripts/setup-release-signing.test.mjs",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@percaya/core": "file:../../packages/core",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.1.3",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.1.3",
    "@solana/web3.js": "^1.98.0",
    "buffer": "^6.0.3",
    "expo": "~52.0.37",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-dev-client": "~5.0.12",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.9",
    "lucide-react-native": "^0.475.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-get-random-values": "~1.11.0",
    "react-native-qrcode-svg": "^6.3.56",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.8.2"
  }
}
